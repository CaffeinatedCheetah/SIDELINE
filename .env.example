# Pooled PostgreSQL connection used by the application at runtime. For a
# Supabase transaction pooler use port 6543 and append
# ?pgbouncer=true&connection_limit=1.
DATABASE_URL="postgresql://fantakes:fantakes@localhost:5432/fantakes?schema=public"
# Direct PostgreSQL connection used only by Prisma migrations. For local
# PostgreSQL this may be identical to DATABASE_URL.
DIRECT_URL="postgresql://fantakes:fantakes@localhost:5432/fantakes?schema=public"
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
# Optional Google OAuth. Omit both values to hide this provider locally.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional SMTP magic links. Without SMTP, development links are logged locally.
EMAIL_SERVER=""
EMAIL_FROM="FanTakes <no-reply@example.test>"
# Development only. Production validation rejects true.
ENABLE_DEV_AUTH="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional Playwright origin. Keep this equal to AUTH_URL for authenticated
# browser tests so auth cookies remain on the same host.
PLAYWRIGHT_BASE_URL="http://localhost:3000"
# Optional integrations. Leave blank to use deterministic demo sports data and
# disable analytics delivery.
NEXT_PUBLIC_ANALYTICS_ID=""
SPORTS_API_BASE_URL=""
SPORTS_API_KEY=""
# Explicit safety gate for manually seeding a production-mode preview database.
# Never enable this for a production database.
ALLOW_PREVIEW_SEED="false"
# Required by scheduled operational endpoints. Send as Bearer authorization.
CRON_SECRET=""
# Optional operational failure alert destination.
OPS_ALERT_WEBHOOK_URL=""
# Required only for the audited role-management CLI.
MODERATION_OPERATOR_EMAIL=""
# Disposable FanTakes-only test database. Never set this to Production.
FANTAKES_TEST_DATABASE_URL=""
FANTAKES_TEST_DIRECT_URL=""
ALLOW_REMOTE_FANTAKES_TEST_DB="false"
