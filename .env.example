# PostgreSQL connection used by the application at runtime.
# Docker Compose uses the internal host name "db"; host-based development uses localhost.
DATABASE_URL="postgresql://fantakes:fantakes@localhost:5432/fantakes?schema=public"
# Direct PostgreSQL connection used by Prisma migrations. For self-hosted
# PostgreSQL this may be identical to DATABASE_URL.
DIRECT_URL="postgresql://fantakes:fantakes@localhost:5432/fantakes?schema=public"
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
# Optional Google OAuth. Omit both values to hide this provider locally.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional SMTP magic links. Without SMTP, email login is hidden unless dev auth is enabled.
EMAIL_SERVER=""
EMAIL_FROM="FanTakes <no-reply@example.test>"
# Development only. Production validation rejects true.
ENABLE_DEV_AUTH="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional Playwright origin. Keep this equal to AUTH_URL for authenticated
# browser tests so auth cookies remain on the same host.
PLAYWRIGHT_BASE_URL="http://localhost:3000"
# Optional legacy integrations. The active sports service uses ESPN by default.
NEXT_PUBLIC_ANALYTICS_ID=""
SPORTS_API_BASE_URL=""
SPORTS_API_KEY=""
# Deterministic play-by-play used only by tests and isolated Preview fixtures.
SPORTS_MOMENTS_FIXTURE_PATH=""
# Explicit safety gate for manually seeding a production-mode preview database.
# Never enable this for a production database.
ALLOW_PREVIEW_SEED="false"
# Required by scheduled operational endpoints. Send as Bearer authorization.
CRON_SECRET=""
# Required for approximate Game Room presence. Heartbeats expire in KV and
# are never written to PostgreSQL.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Optional operational failure alert destination.
OPS_ALERT_WEBHOOK_URL=""
# Required only for the audited role-management CLI.
MODERATION_OPERATOR_EMAIL=""
# Disposable FanTakes-only test database. Never set this to Production.
FANTAKES_TEST_DATABASE_URL=""
FANTAKES_TEST_DIRECT_URL=""
ALLOW_REMOTE_FANTAKES_TEST_DB="false"

# Docker Compose reads these values from a local .env file.
# Never commit the real password.
POSTGRES_DB="fantakes"
POSTGRES_USER="fantakes"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_PORT="5432"
APP_PORT="3000"
# Optional AI platform. All features are dark by default and remain safe when
# the API key is absent. Never expose this key through NEXT_PUBLIC variables.
OPENAI_API_KEY=""
OPENAI_AI_ENABLED="false"
OPENAI_GAME_RECAPS_ENABLED="false"
OPENAI_AI_ADMIN_GENERATION_ENABLED="false"
OPENAI_SUMMARY_MODEL="gpt-5.4-mini"
OPENAI_COMPLEX_MODEL="gpt-5.4"
OPENAI_AI_DAILY_BUDGET_USD="5"
OPENAI_AI_DAILY_GENERATION_LIMIT="25"
OPENAI_AI_MAX_INPUT_TOKENS="12000"
OPENAI_AI_MAX_OUTPUT_TOKENS="1800"
OPENAI_AI_TIMEOUT_MS="30000"

# AI generation fails closed until the selected model and its current pricing
# are explicitly approved. Use current provider prices per million tokens.
OPENAI_AI_PRICED_MODEL=""
OPENAI_AI_INPUT_USD_PER_MILLION=""
OPENAI_AI_OUTPUT_USD_PER_MILLION=""
ANTHROPIC_API_KEY=""
SCOUT_AI_PRICED_MODEL=""
SCOUT_AI_INPUT_USD_PER_MILLION=""
SCOUT_AI_OUTPUT_USD_PER_MILLION=""
SCOUT_AI_DAILY_BUDGET_USD="5"
SCOUT_AI_DAILY_GENERATION_LIMIT="25"
